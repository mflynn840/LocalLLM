LITELLM_MASTER_KEY=sk-local-dev-change-me
LITELLM_DB_PASSWORD=generate-with-install
LITELLM_SALT_KEY=generate-with-install
MODEL_SIGNUP_CODE=generate-with-install
BACKEND_PUBLIC_URL=http://192.168.4.40:4000
BACKEND_BIND_ADDRESS=0.0.0.0
LLAMA_API_KEY=local-no-auth
LITELLM_PORT=4001
OPEN_WEBUI_PORT=3001
OPENHANDS_PORT=8000
OPENHANDS_BIND_ADDRESS=127.0.0.1
LOCAL_BACKEND_API_KEY=generate-with-install
CONTEXT_SIZE=100000
DEFAULT_MODEL=gemma-4-12b
DEFAULT_QUANT=Q4_K_M
WORKSPACE_DIR=./workspace
OPENHANDS_HOST_HOME=/home/your-wsl-user
OPENHANDS_WORKSPACE_PATH=/projects
OPENHANDS_WORKSPACE_GID=1000
OPENHANDS_UID=10001
OPENHANDS_MEMORY_LIMIT=16g
OPENHANDS_CPU_LIMIT=8
OPENHANDS_SANDBOX_LEVEL=full-control
# OpenHands access control: restricted | read-only | read-write | full-control
#   restricted   : read-only files, no internet, no shell commands, locked-down container
#   read-only    : read-only files, no internet, no shell commands
#   read-write   : read/write files, no internet, no shell commands
#   full-control : read/write files, internet allowed, shell commands enabled (default)
OPENHANDS_ALLOW_COMMANDS=true
OPENHANDS_READ_ONLY_ROOT=false
# When true (with full-control or any command-allowing mode), OpenHands will
# request approval before executing each shell command.
OPENHANDS_REQUIRE_APPROVAL=false
WEB_SEARCH_ENABLED=true
SEARXNG_SECRET=generate-with-install
WEB_LOADER_API_KEY=generate-with-install
WEBUI_ADMIN_EMAIL=owner@localhost
WEBUI_ADMIN_PASSWORD=generate-with-install
WEBUI_SECRET_KEY=generate-with-install
