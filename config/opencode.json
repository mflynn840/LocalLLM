{
  "$schema": "https://opencode.ai/config.json",
  "model": "local/local-model",
  "update": "disable",
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000
    },
    "buffer": "15%"
  },
  "providers": {
    "local": {
      "name": "Local LiteLLM",
      "env": ["LITELLM_MASTER_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:4000/v1"
      },
      "models": {
        "local-model": {
          "name": "Selected model via LiteLLM",
          "limit": {
            "context": 100000,
            "output": 4096
          }
        }
      }
    }
  }
}
