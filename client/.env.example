# URL of the backend's LiteLLM gateway (published port on the backend machine).
# Must match the backend's LITELLM_PORT (default 4001 in backend .env.example).
MODEL_SERVER_URL=http://<BACKEND_LAN_IP>:4001
MODEL_API_KEY=sk-replace-with-your-personal-key
LOCAL_BACKEND_API_KEY=generate-with-start
CLIENT_OPENHANDS_PORT=8000
